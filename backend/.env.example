# Copy this file to .env and change what you need. Never commit .env.

# --- Local LLM -------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=180
# Smaller context = less memory (fits a 4 GB GPU).
OLLAMA_NUM_CTX=2048
# Uncomment to force CPU-only inference if you get "cudaMalloc failed: out of memory".
# OLLAMA_NUM_GPU=0
ENABLE_AI_REPORT=true

# --- Network enrichment ----------------------------------------------
ENABLE_NETWORK_LOOKUPS=true
WHOIS_TIMEOUT=5
DNS_TIMEOUT=3
MAX_DOMAIN_LOOKUPS=5

# --- Threat intelligence (VirusTotal free tier = 4 requests/minute) --
# VIRUSTOTAL_API_KEY=your-key-here
ENABLE_THREAT_INTEL=true
MAX_TI_LOOKUPS=4
# Free tier allows 4 requests per minute; raise for a paid key.
VT_REQUESTS_PER_MINUTE=4
VT_MAX_WAIT_SECONDS=65
VT_PAUSE_AFTER_429=120
